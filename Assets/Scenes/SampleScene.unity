  - nome: Etapa 5(falta passos)
    Falasintroducao: []
    falasFinalizacao: []
    passos:
    - tipoConclusao: 3
      minigame: {fileID: 606207645}
      objetoAlvo: {fileID: 0}
      destino: {fileID: 0}
      falas:
      - texto: "Leve a escova at\xE9 a boca e comece a escovar os dentes. "
        audio: {fileID: 8300000, guid: fccf4b7a1fb62e04d89bd8d2baecdf35, type: 3}
      falasFinalizacao:
      - texto: "Perfeito! Seus dentes est\xE3o limpinhos!"
        audio: {fileID: 8300000, guid: 399ac8c0dd742324eb61c71c858afb55, type: 3}
      concluido: 0
      salvarSnapshot: 1
      aoIniciar:
        m_PersistentCalls:
