  - nome: Etapa 6
    Falasintroducao: []
    falasFinalizacao: []
    passos:
    - tipoConclusao: 3
      minigame: {fileID: 850290695}
      objetoAlvo: {fileID: 1347392257}
      destino: {fileID: 0}
      falas:
      - texto: "Pegue um pouco de \xE1gua"
        audio: {fileID: 8300000, guid: 71d9e0ea5a053dd4fb4e1630ad75c344, type: 3}
      falasFinalizacao:
      - texto: Muito bem. Encheu direitinho!
