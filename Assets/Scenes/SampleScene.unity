    - tipoConclusao: 0
      minigame: {fileID: 0}
      objetoAlvo: {fileID: 1347392257}
      destino: {fileID: 1347392258}
      falas:
      - texto: 'Abra a torneira devagar para molhar a escova. '
        audio: {fileID: 8300000, guid: 7dd6e8c28d3c2184aa3b3d1a63ff1632, type: 3}
      falasFinalizacao:
      - texto: Excelente! Abriu certinho a torneira
        audio: {fileID: 8300000, guid: 37223d8d2e222ca499faf3d69fc9a967, type: 3}
      concluido: 0
      salvarSnapshot: 1
      aoIniciar:
        m_PersistentCalls:
          m_Calls: []
      aoConcluir:
